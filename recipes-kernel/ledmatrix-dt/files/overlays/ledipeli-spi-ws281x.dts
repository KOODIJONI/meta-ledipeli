/dts-v1/;
/plugin/;

/ {
    compatible = "brcm,bcm2712";

    fragment@0 {
        target = <&spi0>;

        __overlay__ {
            status = "okay";
            #address-cells = <1>;
            #size-cells = <0>;

            ledmatrix0: ledmatrix@0 {
                compatible = "joni,ledmatrix-channel";
                reg = <0>;
                joni,channel = <0>;
                spi-max-frequency = <6400000>;
                status = "okay";
            };
        };
    };

    fragment@1 {
        target-path = "/axi/pcie@120000/rp1/spi@54000";

        __overlay__ {
            status = "okay";
            #address-cells = <1>;
            #size-cells = <0>;

            ledmatrix1: ledmatrix@0 {
                compatible = "joni,ledmatrix-channel";
                reg = <0>;
                joni,channel = <1>;
                spi-max-frequency = <6400000>;
                status = "okay";
            };
        };
    };
fragment@2 {
    target-path = "/axi/pcie@120000/rp1/spi@64000";

    __overlay__ {
        status = "okay";
        #address-cells = <1>;
        #size-cells = <0>;

        ledmatrix2: ledmatrix@0 {
            compatible = "joni,ledmatrix-channel";
            reg = <0>;
            joni,channel = <2>;
            spi-max-frequency = <6400000>;
            status = "okay";
        };
    };
};

fragment@7 {
    target = <&rp1_gpio>;

    __overlay__ {
        ledmatrix_spi1_pins: ledmatrix-spi1-pins {
            spi1-other-pins {
                function = "spi1";
                pins = "gpio19", "gpio21";
                bias-disable;
            };

            spi1-mosi-pin {
                function = "spi1";
                pins = "gpio20";
                bias-pull-down;
            };
        };

        ledmatrix_spi5_pins: ledmatrix-spi5-pins {
            spi5-pins {
                function = "spi5";
                pins = "gpio13", "gpio14", "gpio15";
                bias-disable;
            };
        };
    };
};

fragment@4 {
    target-path = "/axi/pcie@120000/rp1/spi@54000";

    __overlay__ {
        pinctrl-names = "default";
        pinctrl-0 = <&ledmatrix_spi1_pins>;
    };
};

fragment@5 {
    target-path = "/axi/pcie@120000/rp1/spi@64000";

    __overlay__ {
        pinctrl-names = "default";
        pinctrl-0 = <&ledmatrix_spi5_pins>;
    };
};
    fragment@6 {
        target-path = "/axi/pcie@120000/rp1/spi@50000/spidev@0";

        __overlay__ {
            status = "disabled";
        };
    };
};
