[Unit]
Description=High-Performance Hand Tracker & IPC Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/hand_tracker
ExecStart=/usr/bin/python3 /opt/hand_tracker/main.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target