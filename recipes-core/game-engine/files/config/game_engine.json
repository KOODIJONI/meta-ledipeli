{
        
    "engine": {
        "name": "game-engine",
        "version": "1.0.0",
        "matrix_config_path": "/etc/ledmatrix-driver/matrix_config.json",
        "hand_tracker_socket": "/tmp/hand_tracker.sock",
        "fps": 60,
        "width": 640,
        "height": 480,
        "simulate": true
    },
    "startup": {
        "initial_game": "test_game",
        "available_games": ["test_game","animations"]  
    },

    "tetris": {
        "start_level": 1,
        "drop_interval_ms": 700
    },
    "debug": {
        "log_level": "info",
        "print_input": false,
        "show_fps": true
    },
    "mqtt": {
    "enabled": true,
    "broker_url": "tcp://localhost:1883"
    }
}
